rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      // New client-created profiles must stay at the least-privileged Operator role.
      allow create: if isOwner(uid)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == "Operator";

      // Operators can update their own profile, but cannot self-promote roles.
      // This also permits updating non-sensitive preference fields.
      allow update: if isOwner(uid)
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role;

      allow delete: if false;
    }

    // Shared operational records are readable/writable only by authenticated users.
    match /missions/{missionId} {
      allow read, write: if isSignedIn();
    }

    match /detections/{detectionId} {
      allow read, write: if isSignedIn();
    }

    match /anomalies/{anomalyId} {
      allow read, write: if isSignedIn();
    }

    match /reports/{reportId} {
      allow read, write: if isSignedIn();
    }

    // Operator decisions are private to the account that created them.
    match /operatorFeedback/{feedbackId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;

      allow read: if isSignedIn()
        && resource.data.uid == request.auth.uid;

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
